    "import os\n",
    "import shutil\n",
    "\n",
    "# 定义augment.py的路径（根据实际位置调整，通常是这个路径）\n",
    "augment_path = \"/kaggle/working/stylegan3/training/augment.py\"\n",
    "\n",
    "\n",
    "# 读取文件内容\n",
    "with open(augment_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    lines = f.readlines()\n",
    "\n",
    "# 需要修改的参数（键：原参数名，值：目标值+注释）\n",
    "target_params = {\n",
    "    \"self.rotate\": \"0.0\",\n",
    "    \"self.scale\": \"0.0\",\n",
    "    \"self.hue\": \"0.0\",\n",
    "    \"self.saturation\": \"0.0\",\n",
    "    \"self.xflip\": \"0.5\",\n",
    "\n",
    "}\n",
    "\n",
    "new_lines = []\n",
    "# 遍历每行，修改目标参数\n",
    "for line in lines:\n",
    "    # 检查当前行是否包含需要修改的参数\n",
    "    for param, new_value in target_params.items():\n",
    "        if param in line and \"=\" in line:\n",
    "            # 保留原缩进，替换参数值\n",
    "            indent = line[:len(line) - len(line.lstrip())]  # 获取缩进\n",
    "            line = f\"{indent}{param} = {new_value}\\n\"  # 替换为新值\n",
    "            break  # 找到后跳出循环，避免重复修改\n",
    "    new_lines.append(line)\n",
    "\n",
    "# 写入修改后的内容\n",
    "with open(augment_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    f.writelines(new_lines)\n",
    "\n",
    "print(\"augment.py修改完成！已关闭破坏结构的增强，保留安全变换\")"
   ]
